{
  "name": "plain",
  "privileged": true,
  "remoteUser": "ubuntu",
  "image": "${templateOption:image}",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "version": "latest",
      "configureZshAsDefaultShell": true,
      "username": "ubuntu",
      "userUid": "1000",
      "userGid": "1000"
    },
    "ghcr.io/tadachs/devcontainer-features/neovim:latest": {
      "install_method": "ppa"
    },
    "ghcr.io/tadachs/devcontainer-features/claude-code:latest": {},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "tmux,ripgrep,${templateOption:additionalAptPackages}"
    },
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "workspaceFolder": "/home/ubuntu/ws",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ubuntu/ws,type=bind",
  "containerEnv": {},
  "runArgs": [
    "--net=host",
    "-e",
    "DISPLAY=${env:DISPLAY}",
    "-e",
    "TERM=${env:TERM}",
    "-e",
    "SHELL=${env:SHELL}",
    "-v",
    "${env:SSH_AUTH_SOCK}:/tmp/ssh-agent.socket",
    "-e",
    "SSH_AUTH_SOCK=/tmp/ssh-agent.socket",
    "--runtime=nvidia",
    "--gpus=all"
  ],
  "mounts": [
    {
      "source": "/tmp/.X11-unix",
      "target": "/tmp/.X11-unix",
      "type": "bind",
      "consistency": "cached"
    },
    {
      "source": "/dev/dri",
      "target": "/dev/dri",
      "type": "bind",
      "consistency": "cached"
    },
    {
      "source": "/dev/shm",
      "target": "/dev/shm",
      "type": "bind",
      "consistency": "cached"
    }
  ],
  "postCreateCommand": {
    "video-group": "sudo usermod -aG video ubuntu",
    "node-install": ". ${NVM_DIR}/nvm.sh && nvm install --lts"
  }
}
