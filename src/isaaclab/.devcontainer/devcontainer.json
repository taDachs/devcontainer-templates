{
  "name": "isaac-lab-devcontainer",
  "privileged": true,
  "remoteUser": "ubuntu",
  "dockerComposeFile": "compose.yaml",
  "service": "isaac-lab-devcontainer",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "version": "latest",
      "configureZshAsDefaultShell": true,
      "username": "ubuntu",
      "userUid": "1000",
      "userGid": "1000"
    },
    "ghcr.io/tadachs/devcontainer-features/neovim:latest": {
      "install_method": "ppa"
    },
    "ghcr.io/tadachs/devcontainer-features/claude-code:latest": {},
    "ghcr.io/tadachs/devcontainer-features/locale:latest": {
      "locale": "en_US.UTF-8"
    },
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "tmux,ripgrep,stow,python3-virtualenv,python3-venv,build-essential"
    },
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "workspaceFolder": "/home/ubuntu/isaac-lab-devcontainer",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ubuntu/isaac-lab-devcontainer,type=bind",
  "containerEnv": {},
  "postCreateCommand": {
    "video-group": "sudo usermod -aG video ubuntu",
    "node-install": ". ${NVM_DIR}/nvm.sh && nvm install --lts"
  }
}
